        { "properties": { "externalName": { "const": "session/resume" }, "objectKind": { "const": "ACP_AGENT_METHOD" }, "messageKind": { "const": "REQUEST" }, "direction": { "const": "CLIENT_TO_AGENT" }, "externalMetadataSha256": { "const": "809b6ec7f68efc9dfa3e31188c547e0fa35b407ab5e6d35da24601f840b8121d" } } }
