      ]
    },
    "methodSessionUpdate": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "externalName": { "const": "session/update" }, "objectKind": { "const": "ACP_NOTIFICATION" }, "messageKind": { "const": "NOTIFICATION" }, "direction": { "const": "AGENT_TO_CLIENT" }, "externalMetadataSha256": { "const": "5765d7e8d5a9e6830733dbc8de23248d0d8d578a342013d70a1cbd7e81f3425b" } } }
