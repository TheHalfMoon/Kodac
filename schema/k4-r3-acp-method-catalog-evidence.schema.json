        { "properties": { "externalName": { "const": "session/request_permission" }, "objectKind": { "const": "ACP_CLIENT_METHOD" }, "messageKind": { "const": "REQUEST" }, "direction": { "const": "AGENT_TO_CLIENT" }, "externalMetadataSha256": { "const": "c15f6b31a5939c1d6c46869ce1f6869154713769d3149505e3f4bfc435304d06" } } }
