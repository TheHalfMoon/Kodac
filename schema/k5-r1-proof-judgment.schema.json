{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/k5-r1-proof-judgment.schema.json",
  "title": "Kodac K5-R1 Proof Judgment",
  "$comment": "Runtime validation is authoritative for canonical ordering, byte bounds, package/result cross-consistency, reason inclusion/support semantics, and judgment identity recomputation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packageIdentity",
    "status",
    "reasons",
    "requirementResults",
    "evidenceIds",
    "judgmentIdentity"
  ],
  "properties": {
    "version": {
      "const": "kodac-k5-r1-proof-judgment-v1"
    },
    "packageIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "INVALID_PACKAGE",
        "STALE_PACKAGE",
        "CONTRADICTORY_PACKAGE",
        "INSUFFICIENT_PACKAGE",
        "SUFFICIENT_PACKAGE"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "requirementResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "judgmentIdentity": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "VERIFICATION",
        "EXECUTION_RECEIPT",
        "REPOSITORY_STATE",
        "REVIEW_ADJUDICATION",
        "ARTIFACT",
        "CUSTOM"
      ]
    },
    "requirementStatus": {
      "enum": [
        "INVALID",
        "STALE",
        "CONTRADICTORY",
        "INSUFFICIENT",
        "SATISFIED"
      ]
    },
    "reasonStatus": {
      "enum": [
        "INVALID",
        "STALE",
        "CONTRADICTORY",
        "INSUFFICIENT"
      ]
    },
    "reasonCode": {
      "enum": [
        "EXPLICIT_INVALID",
        "KIND_MISMATCH",
        "REVISION_MISMATCH",
        "EXPLICIT_STALE",
        "EXPLICIT_CONTRADICTORY",
        "SATISFIED_FAILED_CONFLICT",
        "FINGERPRINT_STATUS_CONFLICT",
        "EXPLICIT_FAILED",
        "BELOW_MINIMUM"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "kind",
        "minimumEvidence",
        "satisfiedFingerprintCount",
        "status"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "minimumEvidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "satisfiedFingerprintCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "status": {
          "$ref": "#/$defs/requirementStatus"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "status",
        "codes",
        "evidenceIds"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "status": {
          "$ref": "#/$defs/reasonStatus"
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reasonCode"
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        }
      }
    }
  }
}
