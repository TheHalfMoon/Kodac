{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/k5-r1-proof-package.schema.json",
  "title": "Kodac K5-R1 Proof Package",
  "$comment": "Runtime validation is authoritative for UTF-8 byte bounds, proxy/accessor/symbol/prototype rejection, Unicode scalar validity, canonical set ordering, package identity recomputation, cross-reference existence, and semantic judgment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packageIdentity",
    "subject",
    "revision",
    "requirements",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": "kodac-k5-r1-proof-package-v1"
    },
    "packageIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "$comment": "uniqueItems enforces deep JSON equality only; runtime additionally enforces package-wide requirementId uniqueness.",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true,
      "$comment": "uniqueItems enforces deep JSON equality only; runtime additionally enforces package-wide evidenceId uniqueness.",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId",
        "subjectKind"
      ],
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "$comment": "Runtime enforces <=256 UTF-8 bytes and valid Unicode scalar values."
        },
        "subjectKind": {
          "enum": [
            "TASK",
            "CHANGESET",
            "VERIFICATION"
          ]
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "canonicalBase",
        "candidateHead"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "$comment": "Runtime enforces <=512 UTF-8 bytes and valid Unicode scalar values."
        },
        "canonicalBase": {
          "$ref": "#/$defs/gitSha"
        },
        "candidateHead": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "kind": {
      "enum": [
        "VERIFICATION",
        "EXECUTION_RECEIPT",
        "REPOSITORY_STATE",
        "REVIEW_ADJUDICATION",
        "ARTIFACT",
        "CUSTOM"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "kind",
        "minimumEvidence"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "$comment": "Runtime enforces <=128 UTF-8 bytes, valid Unicode scalar values, and package-wide uniqueness."
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "minimumEvidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "kind",
        "requirementIds",
        "canonicalBase",
        "candidateHead",
        "ref",
        "digest",
        "status"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "$comment": "Runtime enforces <=128 UTF-8 bytes, valid Unicode scalar values, and package-wide uniqueness."
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "$comment": "Runtime enforces existing requirement references, <=128 UTF-8 bytes each, valid Unicode scalar values, and canonical scalar sorting."
        },
        "canonicalBase": {
          "$ref": "#/$defs/gitSha"
        },
        "candidateHead": {
          "$ref": "#/$defs/gitSha"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "$comment": "Runtime enforces <=1024 UTF-8 bytes and valid Unicode scalar values."
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "SATISFIED",
            "FAILED",
            "STALE",
            "CONTRADICTORY",
            "INVALID"
          ]
        }
      }
    }
  }
}
