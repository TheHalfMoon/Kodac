{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/k5-r4-proof-state-reconciliation.schema.json",
  "title": "Kodac K5-R4 Proof-State Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packageIdentity",
    "r2LinkageIdentity",
    "r3LinkageIdentity",
    "revision",
    "status",
    "results",
    "outOfScopeEvidenceIds",
    "reconciliationIdentity"
  ],
  "properties": {
    "version": { "const": "kodac-k5-r4-proof-state-reconciliation-v1" },
    "packageIdentity": { "$ref": "#/$defs/sha256" },
    "r2LinkageIdentity": { "$ref": "#/$defs/sha256" },
    "r3LinkageIdentity": { "$ref": "#/$defs/sha256" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": {
      "enum": ["NOT_APPLICABLE", "VALID", "INCOMPLETE", "STALE", "CONTRADICTORY", "INVALID"]
    },
    "results": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/result" }
    },
    "outOfScopeEvidenceIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceId" }
    },
    "reconciliationIdentity": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } }, "required": ["status"] },
      "then": { "properties": { "results": { "maxItems": 0 } } },
      "else": { "properties": { "results": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "results": { "maxItems": 0 } }, "required": ["results"] },
      "then": { "properties": { "status": { "const": "NOT_APPLICABLE" } } }
    }
  ],
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "canonicalBase", "candidateHead"],
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "canonicalBase": { "$ref": "#/$defs/sha40" },
        "candidateHead": { "$ref": "#/$defs/sha40" }
      }
    },
    "cause": {
      "enum": [
        "R1_EXPLICIT_INVALID",
        "R2_KIND_MISMATCH",
        "R2_REF_MISMATCH",
        "R2_DIGEST_MISMATCH",
        "R3_REF_MISMATCH",
        "R3_DIGEST_MISMATCH",
        "R1_EXPLICIT_STALE",
        "R2_REVISION_MISMATCH",
        "R3_REVISION_MISMATCH",
        "R1_EXPLICIT_CONTRADICTORY",
        "R1_EXPLICIT_FAILED",
        "R2_NO_SOURCE",
        "R3_NO_SOURCE"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceKind",
        "r1Status",
        "linkageLayer",
        "linkStatus",
        "sourceIdentity",
        "state",
        "causes"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/evidenceId" },
        "evidenceKind": {
          "enum": ["VERIFICATION", "EXECUTION_RECEIPT", "REPOSITORY_STATE", "REVIEW_ADJUDICATION"]
        },
        "r1Status": {
          "enum": ["SATISFIED", "FAILED", "STALE", "CONTRADICTORY", "INVALID"]
        },
        "linkageLayer": { "enum": ["K5_R2", "K5_R3"] },
        "linkStatus": { "enum": ["LINKED", "UNLINKED", "MISMATCH"] },
        "sourceIdentity": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "state": { "enum": ["VALID", "INCOMPLETE", "STALE", "CONTRADICTORY", "INVALID"] },
        "causes": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/cause" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidenceKind": { "const": "REVIEW_ADJUDICATION" } },
            "required": ["evidenceKind"]
          },
          "then": { "properties": { "linkageLayer": { "const": "K5_R3" } } },
          "else": { "properties": { "linkageLayer": { "const": "K5_R2" } } }
        },
        {
          "if": {
            "properties": { "linkStatus": { "const": "UNLINKED" } },
            "required": ["linkStatus"]
          },
          "then": { "properties": { "sourceIdentity": { "type": "null" } } },
          "else": { "properties": { "sourceIdentity": { "$ref": "#/$defs/sha256" } } }
        }
      ]
    }
  }
}
