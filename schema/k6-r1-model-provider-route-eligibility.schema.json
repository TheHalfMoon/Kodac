{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/k6-r1-model-provider-route-eligibility.schema.json",
  "title": "Kodac K6-R1 Model-Provider Route Eligibility",
  "oneOf": [
    { "$ref": "#/$defs/routeRequest" },
    { "$ref": "#/$defs/routeEligibilityResult" }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_-]*(?:[./:][a-z][a-z0-9_-]*)+$"
    },
    "riskClass": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "privacyClass": { "enum": ["PUBLIC", "REPOSITORY_PRIVATE", "SENSITIVE"] },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "provider", "model", "workspaceDigest", "status", "reportDigest"],
      "properties": {
        "protocol": { "const": "kodac.provider-qualification" },
        "version": { "const": 1 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "model": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
        "workspaceDigest": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["PASS", "FAIL", "PENDING"] },
        "reportDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "candidateKind", "provider", "model", "declaredCapabilities", "maximumRiskClass", "supportedPrivacyClasses", "qualification"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "candidateKind": { "const": "MODEL_PROVIDER" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "model": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
        "declaredCapabilities": { "type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "maximumRiskClass": { "$ref": "#/$defs/riskClass" },
        "supportedPrivacyClasses": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/privacyClass" } },
        "qualification": { "$ref": "#/$defs/qualification" }
      }
    },
    "routeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestIdentity", "repositoryId", "canonicalBase", "candidateHead", "taskId", "riskClass", "privacyClass", "requiredCapabilities", "candidates"],
      "properties": {
        "version": { "const": "kodac-k6-r1-route-request-v1" },
        "requestIdentity": { "$ref": "#/$defs/sha256" },
        "repositoryId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
        "canonicalBase": { "$ref": "#/$defs/gitSha" },
        "candidateHead": { "$ref": "#/$defs/gitSha" },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "riskClass": { "$ref": "#/$defs/riskClass" },
        "privacyClass": { "$ref": "#/$defs/privacyClass" },
        "requiredCapabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "candidates": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "reason": { "enum": ["QUALIFICATION_IDENTITY_MISMATCH", "QUALIFICATION_NOT_PASS", "MISSING_REQUIRED_CAPABILITY", "RISK_CLASS_UNSUPPORTED", "PRIVACY_CLASS_UNSUPPORTED"] },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "candidateKind", "provider", "model", "status", "reasons", "missingCapabilities", "qualificationReportDigest"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "candidateKind": { "const": "MODEL_PROVIDER" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "model": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
        "status": { "enum": ["ELIGIBLE", "INELIGIBLE"] },
        "reasons": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/reason" } },
        "missingCapabilities": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "qualificationReportDigest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ELIGIBLE" } }, "required": ["status"] },
          "then": { "properties": { "reasons": { "maxItems": 0 }, "missingCapabilities": { "maxItems": 0 } } },
          "else": { "properties": { "reasons": { "minItems": 1 } } }
        }
      ]
    },
    "routeEligibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "resultIdentity", "requestIdentity", "repositoryId", "canonicalBase", "candidateHead", "taskId", "candidateResults"],
      "properties": {
        "version": { "const": "kodac-k6-r1-route-eligibility-result-v1" },
        "resultIdentity": { "$ref": "#/$defs/sha256" },
        "requestIdentity": { "$ref": "#/$defs/sha256" },
        "repositoryId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$" },
        "canonicalBase": { "$ref": "#/$defs/gitSha" },
        "candidateHead": { "$ref": "#/$defs/gitSha" },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "candidateResults": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/candidateResult" } }
      }
    }
  }
}
