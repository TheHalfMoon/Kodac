{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehalfmoon.github.io/Kodac/schema/kdo-evidence-session-active.schema.json",
  "title": "Kodac Active Evidence Session Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "sessionId",
    "pid",
    "createdAt"
  ],
  "properties": {
    "protocol": { "const": "kodac.evidence-session-active" },
    "version": { "const": 1 },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "pid": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
