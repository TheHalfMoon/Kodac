{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/o4e-model-backed-reviewer-provider-execution.schema.json",
  "title": "Kodac O4-E Model-Backed O4-D Reviewer Provider Execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "executionIdentity", "status", "providerName", "model", "admissionIdentity",
    "taskId", "policyIdentity", "canonicalBase", "reviewedHead", "evaluatedHead",
    "instructionsIdentity", "acceptedClaimCount", "claims", "failureCode"
  ],
  "properties": {
    "version": { "const": "kodac-o4e-model-backed-o4d-reviewer-provider-execution-v1" },
    "executionIdentity": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": [
        "COMPLETED", "STALE", "PROVIDER_FAILED", "TIMED_OUT", "INVALID_PROVIDER_OUTPUT",
        "BLOCKED_ADMISSION", "BLOCKED_PRE_EXECUTION_HEAD_MISMATCH"
      ]
    },
    "providerName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "admissionIdentity": { "$ref": "#/$defs/sha256" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policyIdentity": { "type": "string", "minLength": 1, "maxLength": 128 },
    "canonicalBase": { "$ref": "#/$defs/gitSha1" },
    "reviewedHead": { "$ref": "#/$defs/gitSha1" },
    "evaluatedHead": { "$ref": "#/$defs/gitSha1" },
    "instructionsIdentity": { "$ref": "#/$defs/sha256" },
    "acceptedClaimCount": { "type": "integer", "minimum": 0, "maximum": 64 },
    "claims": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/claim" } },
    "failureCode": {
      "type": ["string", "null"],
      "enum": ["provider-error", "timeout", "invalid-output", "blocked-admission", "head-mismatch", null]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PROVIDER_FAILED" } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": "provider-error" }, "acceptedClaimCount": { "const": 0 }, "claims": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "TIMED_OUT" } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": "timeout" }, "acceptedClaimCount": { "const": 0 }, "claims": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "INVALID_PROVIDER_OUTPUT" } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": "invalid-output" }, "acceptedClaimCount": { "const": 0 }, "claims": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED_ADMISSION" } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": "blocked-admission" }, "acceptedClaimCount": { "const": 0 }, "claims": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED_PRE_EXECUTION_HEAD_MISMATCH" } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": "head-mismatch" }, "acceptedClaimCount": { "const": 0 }, "claims": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["COMPLETED", "STALE"] } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repositoryPath": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimKey", "path", "summary", "contractClaim", "category", "severity",
        "confidenceBps", "evidenceItemIds"
      ],
      "properties": {
        "claimKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "range": { "$ref": "#/$defs/range" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "contractClaim": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "category": { "type": "string", "minLength": 1, "maxLength": 128 },
        "severity": { "enum": ["blocker", "critical", "high", "medium", "low", "info"] },
        "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "evidenceItemIds": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
