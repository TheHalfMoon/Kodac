{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p5-evidence-relation.schema.json",
  "title": "Kodac P5-R2 Evidence Relation Edge",
  "description": "A pure provider-neutral directed relation edge between two exact P5-R1 evidence provenance binding identities at one exact repository revision. Runtime validation additionally enforces the content-derived relationIdentity. The relation is caller-supplied evidence semantics, not truth, proof, adjudication, authority, graph inference, or verifier execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "relationIdentity",
    "revision",
    "sourceBindingIdentity",
    "relation",
    "targetBindingIdentity"
  ],
  "properties": {
    "version": {
      "const": "p5-r2-evidence-relation-v1"
    },
    "relationIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "sourceBindingIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "relation": {
      "enum": [
        "SUPPORTS",
        "CONTRADICTS",
        "SUPERSEDES"
      ]
    },
    "targetBindingIdentity": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "unicodeScalarText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
    },
    "repositoryId": {
      "allOf": [
        {
          "$ref": "#/$defs/unicodeScalarText"
        },
        {
          "maxLength": 512
        }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "canonicalBase",
        "candidateHead"
      ],
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/repositoryId"
        },
        "canonicalBase": {
          "$ref": "#/$defs/gitCommit"
        },
        "candidateHead": {
          "$ref": "#/$defs/gitCommit"
        }
      }
    }
  }
}
