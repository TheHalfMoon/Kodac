{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-git-change-report-evidence-binding.schema.json",
  "title": "Kodac P7-R11 Git Change Report Evidence Binding",
  "description": "Pure data-only binding from one exact P7-R10 predecessor to the exact historical passing git.diff report shape. It establishes GIT_CHANGE_REPORT_EVIDENCE_BOUND only and grants no receipt-authenticity, command-intent, Git-semantic, ledger-completeness, VERIFIED, Done Gate, execution, or completion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidenceIdentity",
    "state",
    "sourceWorkspaceReferenceEvidenceIdentity",
    "sourceAgentCompletionEvidenceIdentity",
    "sourceCommandSuccessEvidenceIdentity",
    "sourceVerificationReportBindingIdentity",
    "proposalIdentity",
    "authorizationIdentity",
    "intentBindingIdentity",
    "appliedEvidenceIdentity",
    "verificationPlanBindingIdentity",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "postStateDigest",
    "verificationPlanDigest",
    "verificationReportIdentity",
    "verificationSessionId",
    "verificationStartedAt",
    "verificationCompletedAt",
    "gitChangeCheckSummary",
    "gitDiffBytes",
    "gitStatusBytes",
    "gitChangeReceiptEvidence",
    "gitChangeReceiptRefs"
  ],
  "properties": {
    "version": {
      "const": "p7-r11-git-change-report-evidence-binding-v1"
    },
    "evidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "const": "GIT_CHANGE_REPORT_EVIDENCE_BOUND"
    },
    "sourceWorkspaceReferenceEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceAgentCompletionEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommandSuccessEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceVerificationReportBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposalIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizationIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intentBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appliedEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "canonicalBase": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targetHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "postStateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationReportIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationStartedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "verificationCompletedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "gitChangeCheckSummary": {
      "type": "string",
      "pattern": "^Workspace changes are evidenced \\(diffBytes=(?:0|[1-9][0-9]*), statusBytes=(?:0|[1-9][0-9]*)\\)\\.$",
      "maxLength": 4096
    },
    "gitDiffBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 524288
    },
    "gitStatusBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "gitChangeReceiptEvidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {
            "const": "receipt"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "gitChangeReceiptRefs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "gitDiffBytes": {
          "minimum": 1
        }
      }
    },
    {
      "properties": {
        "gitStatusBytes": {
          "minimum": 1
        }
      }
    }
  ]
}
