{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-immutable-patch-proposal.schema.json",
  "title": "Kodac P7-R1 Immutable Patch Proposal",
  "description": "A pure data-only immutable remediation proposal binding one current confirmed KRI-R2 finding to one patch artifact digest and an exact repository-relative declared change set. Runtime validation additionally enforces KRI identity validity, exact canonicalBase/targetHead linkage, first CONFIRM adjudication semantics, canonical ascending unique change paths, deterministic proposal identity, detached immutable output, and bounded JSON-data input. This schema grants no patch application, repository write, K2 execution, autofix, verification, Done Gate, provider/model, network, secret, persistence, telemetry, learning, product-integration, or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "proposalIdentity",
    "state",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "sourceFinding",
    "sourceAdjudication",
    "proposerIdentity",
    "patchArtifactDigest",
    "changes"
  ],
  "properties": {
    "version": { "const": "p7-r1-immutable-patch-proposal-v1" },
    "proposalIdentity": { "$ref": "#/$defs/sha256" },
    "state": { "const": "PROPOSED" },
    "repositoryIdentity": { "$ref": "#/$defs/boundedIdentityText" },
    "canonicalBase": { "$ref": "#/$defs/gitCommit" },
    "targetHead": { "$ref": "#/$defs/gitCommit" },
    "sourceFinding": { "$ref": "https://kodac.dev/schema/kri-finding.schema.json" },
    "sourceAdjudication": { "$ref": "https://kodac.dev/schema/kri-adjudication.schema.json" },
    "proposerIdentity": { "$ref": "#/$defs/boundedIdentityText" },
    "patchArtifactDigest": { "$ref": "#/$defs/sha256" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/change" },
      "description": "Runtime requires unique paths in strict canonical ascending path order."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitBlob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "unicodeScalarText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\u0000\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])+$"
    },
    "boundedIdentityText": {
      "allOf": [
        { "$ref": "#/$defs/unicodeScalarText" },
        { "maxLength": 256 },
        { "pattern": "^(?!.*[\\u0000-\\u001F\\u007F])(?=.*\\S).+$" }
      ]
    },
    "repositoryPath": {
      "allOf": [
        { "$ref": "#/$defs/unicodeScalarText" },
        { "maxLength": 1024 },
        {
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?\\/)(?!.*\\/\\.\\.?$)(?!.*[\\u0000-\\u001F\\u007F]).+$"
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "beforeBlobIdentity", "afterContentDigest"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "operation": { "enum": ["ADD", "MODIFY", "DELETE"] },
        "beforeBlobIdentity": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/gitBlob" }
          ]
        },
        "afterContentDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "ADD" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "beforeBlobIdentity": { "type": "null" },
              "afterContentDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "MODIFY" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "beforeBlobIdentity": { "$ref": "#/$defs/gitBlob" },
              "afterContentDigest": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "DELETE" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "beforeBlobIdentity": { "$ref": "#/$defs/gitBlob" },
              "afterContentDigest": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
