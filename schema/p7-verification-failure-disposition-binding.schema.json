{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-verification-failure-disposition-binding.schema.json",
  "title": "Kodac P7-R7 Receipt-Backed Verification Failure Disposition Binding",
  "description": "Pure data-only binding from one exact P7-R6 failed planned verification command plus its exact K2 failure receipt to the bounded VERIFICATION_FAILED state. It grants no verification execution, retry, VERIFIED, Done Gate, or completion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dispositionIdentity",
    "state",
    "sourceVerificationReportBindingIdentity",
    "proposalIdentity",
    "authorizationIdentity",
    "intentBindingIdentity",
    "appliedEvidenceIdentity",
    "verificationPlanBindingIdentity",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "postStateDigest",
    "verificationPlanDigest",
    "verificationReportIdentity",
    "verificationSessionId",
    "failedCommandId",
    "failedCommandCategory",
    "failedCheckSummary",
    "failedCheckEvidence",
    "executionReceiptIdentity",
    "executionReceiptId",
    "executionInputDigest",
    "executionResolvedExecutable",
    "executionEnvironmentDigest",
    "executionTimeoutMs",
    "executionMaxOutputBytes",
    "executionStartedAt",
    "executionCompletedAt",
    "executionFailureError"
  ],
  "properties": {
    "version": {
      "const": "p7-r7-verification-failure-disposition-binding-v1"
    },
    "dispositionIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "const": "VERIFICATION_FAILED"
    },
    "sourceVerificationReportBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposalIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizationIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intentBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appliedEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "canonicalBase": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targetHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "postStateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationReportIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "failedCommandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "failedCommandCategory": {
      "enum": [
        "syntax",
        "types",
        "lint",
        "tests",
        "custom"
      ]
    },
    "failedCheckSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "failedCheckEvidence": {
      "type": "array",
      "maxItems": 256,
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "receipt",
              "artifact",
              "event",
              "workspace"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "executionReceiptIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionReceiptId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "executionInputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionResolvedExecutable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "executionEnvironmentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "executionMaxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "executionStartedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "executionCompletedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "executionFailureError": {
      "type": "string",
      "maxLength": 8192
    }
  }
}
