{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/p7-workspace-reference-evidence-binding.schema.json",
  "title": "Kodac P7-R10 Workspace Reference Evidence Binding",
  "description": "Pure data-only binding from one exact P7-R9 predecessor to the exact historical workspace.integrity report reference/digest linkage. It establishes WORKSPACE_REFERENCE_EVIDENCE_BOUND only and grants no filesystem-integrity, Git, ledger, VERIFIED, Done Gate, execution, or completion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "evidenceIdentity",
    "state",
    "sourceAgentCompletionEvidenceIdentity",
    "sourceCommandSuccessEvidenceIdentity",
    "sourceVerificationReportBindingIdentity",
    "proposalIdentity",
    "authorizationIdentity",
    "intentBindingIdentity",
    "appliedEvidenceIdentity",
    "verificationPlanBindingIdentity",
    "repositoryIdentity",
    "canonicalBase",
    "targetHead",
    "postStateDigest",
    "verificationPlanDigest",
    "verificationReportIdentity",
    "verificationSessionId",
    "verificationStartedAt",
    "verificationCompletedAt",
    "workspaceCheckSummary",
    "workspaceCheckEvidence",
    "workspaceReference",
    "workspaceReferenceDigest"
  ],
  "properties": {
    "version": {
      "const": "p7-r10-workspace-reference-evidence-binding-v1"
    },
    "evidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "const": "WORKSPACE_REFERENCE_EVIDENCE_BOUND"
    },
    "sourceAgentCompletionEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommandSuccessEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceVerificationReportBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposalIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizationIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intentBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appliedEvidenceIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanBindingIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "canonicalBase": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "targetHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "postStateDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationReportIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationStartedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "verificationCompletedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "workspaceCheckSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "workspaceCheckEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "digest"],
        "properties": {
          "kind": {
            "const": "workspace"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "workspaceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "workspaceReferenceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
